# Copie para .env (que não vai para o git) e preencha.

# Token do bot do Discord (Developer Portal → Bot → Reset Token). Nunca aparece no log.
DISCORD_TOKEN=
# ID do servidor (guild) do Discord onde o relay cria a categoria e os canais das máquinas.
DISCORD_GUILD_ID=
# IDs dos usuários do Discord autorizados a interagir com o relay, separados por vírgula.
ALLOWED_USER_IDS=

# Diretório de dados dentro do contêiner (banco, certificado, backups); o compose monta ./data aqui.
DATA_DIR=/data
# Porta HTTPS/WebSocket onde os agentes se conectam (/ws).
PORT=8443
# Nível de log: debug, info, warn ou error.
LOG_LEVEL=info
